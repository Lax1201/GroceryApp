@page "/admin/dashboard"
@page "/admin"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Panel Administrativo — GroceryApp</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Panel Administrativo</h2>
            <p class="text-muted mb-0">Visibilidad y gestión global del sistema</p>
        </div>
        <span class="badge bg-danger fs-6 px-3 py-2">Rol: Administrador</span>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-primary">Información de Sesión</h5>
                    <hr />
                    <AuthorizeView>
                        <Authorized>
                            <p class="mb-1"><strong>Nombre:</strong> @context.User.Identity?.Name</p>
                            <p class="mb-1"><strong>ID Empleado:</strong> @context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value</p>
                            <p class="mb-1"><strong>Usuario:</strong> @context.User.FindFirst("usuario")?.Value</p>
                            <p class="mb-0"><strong>Alcance:</strong> <span class="badge bg-success">Global (Todas las sucursales)</span></p>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-8">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Módulos Administrativos (Sprint 4)</h5>
                    <hr />
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h6 class="fw-bold mb-1">📦 Catálogo de Productos</h6>
                                <p class="small text-muted mb-2">Creación, edición, precios y stock por sucursal.</p>
                                <span class="badge bg-secondary">Próximo paso de implementación</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h6 class="fw-bold mb-1">🏬 Gestión de Sucursales</h6>
                                <p class="small text-muted mb-2">Administración de tiendas y horarios de atención.</p>
                                <span class="badge bg-secondary">Próximo paso de implementación</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h6 class="fw-bold mb-1">📋 Cola Global de Pedidos</h6>
                                <p class="small text-muted mb-2">Monitoreo de pedidos de todas las sucursales.</p>
                                <a href="/sucursal/pedidos" class="btn btn-sm btn-outline-primary">Ver Cola</a>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h6 class="fw-bold mb-1">🛵 Vista de Repartidores</h6>
                                <p class="small text-muted mb-2">Supervisión de entregas y pool de despacho.</p>
                                <a href="/repartidor/entregas" class="btn btn-sm btn-outline-primary">Ver Entregas</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
