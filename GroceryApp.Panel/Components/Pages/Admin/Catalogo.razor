    // --- ACCIONES FOTO ---
    private void AbrirModalFoto(ProductoAdminDto p)
    {
        ProductoSeleccionado = p;
        ArchivoSeleccionado = null;
        MostrarModalFoto = true;
    }

    private void OnFileChangeActualizar(InputFileChangeEventArgs e)
    {
        ArchivoSeleccionado = e.File;
    }

    private async Task GuardarFoto()
    {
        if (ProductoSeleccionado == null || ArchivoSeleccionado == null) return;

        Guardando = true;
        MensajeError = null;
        try
        {
            var exito = await GuardarArchivoFotoAsync(ProductoSeleccionado.Id, ArchivoSeleccionado);
            if (exito)
            {
                MensajeExito = "Fotografía actualizada exitosamente.";
                MostrarModalFoto = false;
                await CargarProductos();
            }
        }
        catch (Exception ex)
        {
            MensajeError = "Error al subir fotografía: " + ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task<bool> GuardarArchivoFotoAsync(int productoId, IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var extensionesValidas = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        if (!extensionesValidas.Contains(extension))
        {
            MensajeError = "Solo se permiten imágenes en formato JPG, PNG o WEBP.";
            return false;
        }

        var carpetaUploads = Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "productos");
        Directory.CreateDirectory(carpetaUploads);

        var nombreArchivo = $"{productoId}-{Guid.NewGuid():N}{extension}";
        var rutaFisica = Path.Combine(carpetaUploads, nombreArchivo);

        await using (var stream = new FileStream(rutaFisica, FileMode.Create))
        {
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);
        }

        var urlRelativa = $"/uploads/productos/{nombreArchivo}";
        var res = await CatalogoService.ActualizarFotoAsync(productoId, urlRelativa);
        if (!res.EsExitoso)
        {
            MensajeError = res.Error;
            return false;
        }

        return true;
    }

    // --- ACCIONES CATEGORÍAS ---
    private void AbrirModalCategorias()
    {
        NuevaCategoriaNombre = string.Empty;
        MostrarModalCategorias = true;
    }

    private async Task CrearCategoria()
    {
        if (string.IsNullOrWhiteSpace(NuevaCategoriaNombre))
        {
            MensajeError = "El nombre de la categoría es obligatorio.";
            return;
        }

        GuardandoCategoria = true;
        try
        {
            var res = await CategoriaService.CrearAsync(NuevaCategoriaNombre);
            if (res.EsExitoso)
            {
                NuevaCategoriaNombre = string.Empty;
                Categorias = await CategoriaService.ListarAsync();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            GuardandoCategoria = false;
        }
    }
}
