@inject PedidoService PedidoService
@inject EntregaService EntregaService

<div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="modal-title fw-bold mb-0">Detalle del Pedido #@PedidoId</h5>
                    @if (Pedido != null)
                    {
                        <span class="badge @ObtenerBadgeEstado(Pedido.Estado) fs-6">@Pedido.Estado</span>
                    }
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
            </div>

            <div class="modal-body p-4">
                @if (Cargando)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando detalle...</span>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(MensajeError) && Pedido == null)
                {
                    <div class="alert alert-danger" role="alert">
                        <h6 class="alert-heading fw-bold">Acceso no autorizado o pedido inexistente</h6>
                        <p class="mb-0">@MensajeError</p>
                    </div>
                }
                else if (Pedido != null)
                {
                    @if (!string.IsNullOrEmpty(MensajeExito))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @MensajeExito
                            <button type="button" class="btn-close" @onclick="() => MensajeExito = null"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(MensajeError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @MensajeError
                            <button type="button" class="btn-close" @onclick="() => MensajeError = null"></button>
                        </div>
                    }

                    <!-- Información General -->
                    <div class="row g-3 mb-4 bg-light p-3 rounded border">
                        <div class="col-12 col-sm-6">
                            <span class="text-muted small d-block">Fecha y Hora de Creación:</span>
                            <strong>@Pedido.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</strong>
                        </div>
                        <div class="col-12 col-sm-6">
                            <span class="text-muted small d-block">Sucursal:</span>
                            <strong>Sucursal #@Pedido.SucursalId</strong>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small d-block">Dirección y Referencia:</span>
                            <strong>@(string.IsNullOrWhiteSpace(Pedido.DireccionReferencia) ? "Sin referencia" : Pedido.DireccionReferencia)</strong>
                        </div>
                    </div>

                    <!-- Items del Pedido -->
                    <h6 class="fw-bold mb-2">Productos del Pedido (@Pedido.Items.Count)</h6>
                    @if (Pedido.Estado == "EnPreparacion")
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <strong>Nota de Preparación:</strong> Si un producto está agotado o dañado, usa el botón <em>Quitar Faltante</em> para retirarlo. El total se recalculará automáticamente.
                        </div>
                    }

                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center" style="width: 90px;">Cantidad</th>
                                    <th class="text-end" style="width: 120px;">Precio Unit.</th>
                                    <th class="text-end" style="width: 120px;">Subtotal</th>
                                    @if (Pedido.Estado == "EnPreparacion")
                                    {
                                        <th class="text-center" style="width: 130px;">Faltante</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Pedido.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@item.ProductoNombre</div>
                                            <div class="text-muted small">ID: #@item.ProductoId</div>
                                        </td>
                                        <td class="text-center fw-bold">@item.Cantidad</td>
                                        <td class="text-end text-muted">C$ @item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end fw-bold">C$ @item.Subtotal.ToString("N2")</td>
                                        @if (Pedido.Estado == "EnPreparacion")
                                        {
                                            <td class="text-center">
                                                <button class="btn btn-outline-danger btn-sm"
                                                        title="Eliminar este producto por no estar disponible"
                                                        @onclick="() => EliminarItemFaltante(item.Id)"
                                                        disabled="@Procesando">
                                                    Quitar
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Resumen Económico -->
                    <div class="row justify-content-end mb-4">
                        <div class="col-12 col-sm-8 col-md-6">
                            <div class="card border-0 bg-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Subtotal Productos:</span>
                                        <strong>C$ @Pedido.Subtotal.ToString("N2")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Tarifa de Envío:</span>
                                        <strong>C$ @Pedido.TarifaEnvio.ToString("N2")</strong>
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between text-primary fs-5 fw-bold">
                                        <span>Total a Cobrar:</span>
                                        <span>C$ @Pedido.Total.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Asignación Manual de Repartidor (Cuando el pedido está Listo) -->
                    @if (Pedido.Estado == "Listo")
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white py-2">
                                <h6 class="mb-0 fw-bold">Despacho / Asignación Manual de Repartidor</h6>
                            </div>
                            <div class="card-body p-3">
                                <p class="small text-muted mb-2">
                                    Este pedido está disponible en el <strong>Pool de autoservicio</strong> de los repartidores. También puedes asignarlo manualmente a un repartidor disponible:
                                </p>
                                <div class="row g-2 align-items-center">
                                    <div class="col-12 col-sm-8">
                                        <select class="form-select" @bind="RepartidorSeleccionadoId">
                                            <option value="0">Seleccionar repartidor...</option>
                                            @foreach (var r in Repartidores)
                                            {
                                                <option value="@r.Id">@r.Nombre (@r.Usuario)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-4">
                                        <button class="btn btn-primary w-100 fw-semibold"
                                                @onclick="AsignarRepartidor"
                                                disabled="@(RepartidorSeleccionadoId == 0 || Procesando)">
                                            Asignar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Botones de Acción y Transiciones -->
            <div class="modal-footer bg-light d-flex justify-content-between flex-wrap gap-2">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>

                @if (Pedido != null)
                {
                    <div class="d-flex gap-2 flex-wrap">
                        @if (Pedido.Estado == "Pendiente")
                        {
                            <button class="btn btn-danger" @onclick="RechazarPedido" disabled="@Procesando">
                                Rechazar Pedido
                            </button>
                            <button class="btn btn-success fw-semibold" @onclick="ConfirmarPedido" disabled="@Procesando">
                                Confirmar Pedido
                            </button>
                        }
                        else if (Pedido.Estado == "Confirmado")
                        {
                            <button class="btn btn-primary fw-semibold" @onclick="IniciarPreparacion" disabled="@Procesando">
                                Iniciar Preparación
                            </button>
                        }
                        else if (Pedido.Estado == "EnPreparacion")
                        {
                            <button class="btn btn-success fw-semibold" @onclick="MarcarListo" disabled="@Procesando">
                                Marcar como Listo
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int PedidoId { get; set; }
    [Parameter] public int? SucursalIdScope { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public EventCallback OnPedidoModificado { get; set; }

    private PedidoDetalleDto? Pedido;
    private List<RepartidorDto> Repartidores = new();
    private int RepartidorSeleccionadoId = 0;

    private bool Cargando = true;
    private bool Procesando = false;
    private string? MensajeError;
    private string? MensajeExito;

    protected override async Task OnParametersSetAsync()
    {
        await CargarDetalle();
    }

    private async Task CargarDetalle()
    {
        Cargando = true;
        MensajeError = null;
        try
        {
            var res = await PedidoService.ObtenerDetallePanelAsync(PedidoId, SucursalIdScope);
            if (res.EsExitoso)
            {
                Pedido = res.Valor;
                if (Pedido!.Estado == "Listo")
                {
                    Repartidores = await EntregaService.ListarRepartidoresPorSucursalAsync(Pedido.SucursalId);
                }
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        catch (Exception ex)
        {
            MensajeError = "Error al cargar detalle del pedido: " + ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task ConfirmarPedido()
    {
        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await PedidoService.ConfirmarAsync(PedidoId, SucursalIdScope);
            if (res.EsExitoso)
            {
                MensajeExito = "Pedido confirmado con éxito.";
                await CargarDetalle();
                await OnPedidoModificado.InvokeAsync();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task RechazarPedido()
    {
        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await PedidoService.RechazarAsync(PedidoId, SucursalIdScope);
            if (res.EsExitoso)
            {
                MensajeExito = "Pedido rechazado.";
                await CargarDetalle();
                await OnPedidoModificado.InvokeAsync();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task IniciarPreparacion()
    {
        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await PedidoService.IniciarPreparacionAsync(PedidoId, SucursalIdScope);
            if (res.EsExitoso)
            {
                MensajeExito = "Preparación iniciada.";
                await CargarDetalle();
                await OnPedidoModificado.InvokeAsync();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task MarcarListo()
    {
        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await PedidoService.MarcarListoAsync(PedidoId, SucursalIdScope);
            if (res.EsExitoso)
            {
                MensajeExito = "Pedido marcado como listo para despacho.";
                await CargarDetalle();
                await OnPedidoModificado.InvokeAsync();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task EliminarItemFaltante(int itemId)
    {
        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await PedidoService.EliminarItemAsync(PedidoId, itemId, SucursalIdScope);
            if (res.EsExitoso)
            {
                MensajeExito = "Producto faltante retirado y totales recalculados.";
                await CargarDetalle();
                await OnPedidoModificado.InvokeAsync();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task AsignarRepartidor()
    {
        if (RepartidorSeleccionadoId == 0) return;

        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await EntregaService.AsignarManualAsync(PedidoId, RepartidorSeleccionadoId, SucursalIdScope);
            if (res.EsExitoso)
            {
                MensajeExito = "Repartidor asignado con éxito.";
                await CargarDetalle();
                await OnPedidoModificado.InvokeAsync();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task CerrarModal()
    {
        await OnCerrar.InvokeAsync();
    }

    private string ObtenerBadgeEstado(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Confirmado" => "bg-primary",
        "EnPreparacion" => "bg-info text-dark",
        "Listo" => "bg-success",
        "EnCamino" => "bg-primary",
        "Entregado" => "bg-success",
        "NoEntregado" => "bg-dark text-white",
        "Cancelado" => "bg-secondary",
        "Rechazado" => "bg-danger",
        _ => "bg-secondary"
    };
}
