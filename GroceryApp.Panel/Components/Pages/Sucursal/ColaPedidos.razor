@page "/sucursal/pedidos"
@page "/sucursal"
@attribute [Authorize(Roles = "EmpleadoSucursal,Admin")]
@inject PedidoService PedidoService
@inject SucursalService SucursalService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Cola de Pedidos — GroceryApp</PageTitle>

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Cola Operativa de Pedidos</h2>
            <p class="text-muted mb-0">Gestión de flujo, preparación y despacho de pedidos en tiempo real</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-primary" @onclick="CargarCola" disabled="@Cargando">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
                </svg>
                Actualizar Cola
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @MensajeExito
            <button type="button" class="btn-close" @onclick="() => MensajeExito = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @MensajeError
            <button type="button" class="btn-close" @onclick="() => MensajeError = null"></button>
        </div>
    }

    <!-- Barra de Filtros y Alcance -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <!-- Selector de Sucursal (Solo para Admin) -->
                @if (EsAdmin)
                {
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-uppercase text-muted mb-1">Filtrar por Sucursal</label>
                        <select class="form-select border-primary" value="@SucursalFiltroId" @onchange="OnSucursalFiltroChanged">
                            <option value="0">Todas las sucursales (Global)</option>
                            @foreach (var s in ListaSucursales)
                            {
                                <option value="@s.Id">@s.Nombre</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-uppercase text-muted mb-1">Ámbito de Operación</label>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-info text-dark fs-6 px-3 py-2">
                                Sucursal Asignada: #@SucursalIdEmpleado
                            </span>
                        </div>
                    </div>
                }

                <!-- Filtro por Estado -->
                <div class="col-12 col-md-8">
                    <label class="form-label small fw-bold text-uppercase text-muted mb-1">Filtrar por Estado</label>
                    <div class="d-flex flex-wrap gap-1">
                        <button class="btn btn-sm @(EstadoFiltro == null ? "btn-dark" : "btn-outline-secondary")" @onclick="() => FiltrarPorEstado(null)">
                            Todos (@Pedidos.Count)
                        </button>
                        <button class="btn btn-sm @(EstadoFiltro == "Pendiente" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")" @onclick='() => FiltrarPorEstado("Pendiente")'>
                            Pendientes (@ContarPorEstado("Pendiente"))
                        </button>
                        <button class="btn btn-sm @(EstadoFiltro == "Confirmado" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FiltrarPorEstado("Confirmado")'>
                            Confirmados (@ContarPorEstado("Confirmado"))
                        </button>
                        <button class="btn btn-sm @(EstadoFiltro == "EnPreparacion" ? "btn-info text-dark fw-bold" : "btn-outline-info text-dark")" @onclick='() => FiltrarPorEstado("EnPreparacion")'>
                            En Prep. (@ContarPorEstado("EnPreparacion"))
                        </button>
                        <button class="btn btn-sm @(EstadoFiltro == "Listo" ? "btn-success" : "btn-outline-success")" @onclick='() => FiltrarPorEstado("Listo")'>
                            Listos (@ContarPorEstado("Listo"))
                        </button>
                        <button class="btn btn-sm @(EstadoFiltro == "EnCamino" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FiltrarPorEstado("EnCamino")'>
                            En Camino (@ContarPorEstado("EnCamino"))
                        </button>
                        <button class="btn btn-sm @(EstadoFiltro == "Entregado" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FiltrarPorEstado("Entregado")'>
                            Entregados (@ContarPorEstado("Entregado"))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Cola de Pedidos -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando pedidos...</span>
                    </div>
                </div>
            }
            else if (PedidosFiltrados.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-inbox" viewBox="0 0 16 16">
                            <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm-1.17-.437A1.5 1.5 0 0 1 4.98 3h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .11.312V13a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V8.5a.5.5 0 0 1 .11-.312zm-1.81 5.437.002.001A.5.5 0 0 1 2 9h4a2.5 2.5 0 0 0 5 0h4a.5.5 0 0 1 .002-.002L15 13a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/>
                        </svg>
                    </div>
                    <p class="text-muted mb-0">No hay pedidos en la cola para este criterio de búsqueda.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 80px;">#ID</th>
                                <th>Fecha / Hora</th>
                                <th>Cliente</th>
                                <th>Sucursal</th>
                                <th>Dirección / Ref.</th>
                                <th class="text-end">Total</th>
                                <th>Estado</th>
                                <th>Despacho</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in PedidosFiltrados)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@p.Id</td>
                                    <td>
                                        <div class="small fw-semibold">@p.FechaCreacion.ToLocalTime().ToString("hh:mm tt")</div>
                                        <div class="small text-muted">@p.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td class="fw-semibold">@p.ClienteNombre</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@p.SucursalNombre</span>
                                    </td>
                                    <td>
                                        <div class="small text-truncate" style="max-width: 180px;" title="@p.DireccionReferencia">
                                            @(string.IsNullOrWhiteSpace(p.DireccionReferencia) ? "Sin ref." : p.DireccionReferencia)
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold text-success fs-6">C$ @p.Total.ToString("N2")</div>
                                        <div class="small text-muted" style="font-size: 0.75rem;">
                                            (Subt: C$ @p.Subtotal.ToString("N2") + Env: C$ @p.TarifaEnvio.ToString("N2"))
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @ObtenerBadgeEstado(p.Estado)">@p.Estado</span>
                                    </td>
                                    <td>
                                        @if (p.Estado == "Listo" && !p.TieneEntregaAsignada)
                                        {
                                            <span class="badge bg-warning text-dark">Pool disponible</span>
                                        }
                                        else if (p.TieneEntregaAsignada)
                                        {
                                            <span class="badge bg-info text-dark" title="Repartidor asignado">
                                                @(p.RepartidorNombre ?? "Repartidor asignado")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => AbrirDetalle(p.Id)">
                                                Detalle
                                            </button>

                                            <!-- Acciones contextuales rápidas -->
                                            @if (p.Estado == "Pendiente")
                                            {
                                                <button class="btn btn-success btn-sm" title="Confirmar Pedido" @onclick="() => ConfirmarRapido(p.Id)">
                                                    Confirmar
                                                </button>
                                                <button class="btn btn-danger btn-sm" title="Rechazar Pedido" @onclick="() => RechazarRapido(p.Id)">
                                                    Rechazar
                                                </button>
                                            }
                                            else if (p.Estado == "Confirmado")
                                            {
                                                <button class="btn btn-primary btn-sm" title="Iniciar Preparación" @onclick="() => IniciarPreparacionRapido(p.Id)">
                                                    Iniciar Prep.
                                                </button>
                                            }
                                            else if (p.Estado == "EnPreparacion")
                                            {
                                                <button class="btn btn-success btn-sm" title="Marcar como Listo" @onclick="() => MarcarListoRapido(p.Id)">
                                                    Listo
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Detalle del Pedido -->
@if (PedidoSeleccionadoId.HasValue)
{
    <DetallePedidoModal PedidoId="@PedidoSeleccionadoId.Value"
                        SucursalIdScope="@ScopeActual"
                        OnCerrar="CerrarDetalle"
                        OnPedidoModificado="CargarCola" />
}

@code {
    private List<PedidoPanelDto> Pedidos = new();
    private List<SucursalDto> ListaSucursales = new();

    private bool Cargando = true;
    private bool EsAdmin = false;
    private int? SucursalIdEmpleado;
    private int SucursalFiltroId = 0;
    private string? EstadoFiltro = null;

    private int? PedidoSeleccionadoId;
    private string? MensajeExito;
    private string? MensajeError;

    private int? ScopeActual => EsAdmin
        ? (SucursalFiltroId > 0 ? SucursalFiltroId : null)
        : SucursalIdEmpleado;

    private List<PedidoPanelDto> PedidosFiltrados => Pedidos
        .Where(p => EstadoFiltro == null || p.Estado == EstadoFiltro)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        EsAdmin = user.IsInRole("Admin");

        if (!EsAdmin)
        {
            var sucursalClaim = user.FindFirst("sucursalId")?.Value;
            if (int.TryParse(sucursalClaim, out var sId))
            {
                SucursalIdEmpleado = sId;
            }
        }
        else
        {
            ListaSucursales = await SucursalService.ListarAsync();
        }

        await CargarCola();
    }

    private async Task OnSucursalFiltroChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            SucursalFiltroId = id;
            await CargarCola();
        }
    }

    private void FiltrarPorEstado(string? estado)
    {
        EstadoFiltro = estado;
    }

    private int ContarPorEstado(string estado) => Pedidos.Count(p => p.Estado == estado);

    private async Task CargarCola()
    {
        Cargando = true;
        MensajeError = null;
        try
        {
            Pedidos = await PedidoService.ListarColaPanelAsync(ScopeActual, null);
        }
        catch (Exception ex)
        {
            MensajeError = "Error al cargar la cola de pedidos: " + ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private void AbrirDetalle(int pedidoId)
    {
        PedidoSeleccionadoId = pedidoId;
    }

    private void CerrarDetalle()
    {
        PedidoSeleccionadoId = null;
    }

    private async Task ConfirmarRapido(int pedidoId)
    {
        MensajeError = null;
        var res = await PedidoService.ConfirmarAsync(pedidoId, ScopeActual);
        if (res.EsExitoso)
        {
            MensajeExito = $"Pedido #{pedidoId} confirmado.";
            await CargarCola();
        }
        else
        {
            MensajeError = res.Error;
        }
    }

    private async Task RechazarRapido(int pedidoId)
    {
        MensajeError = null;
        var res = await PedidoService.RechazarAsync(pedidoId, ScopeActual);
        if (res.EsExitoso)
        {
            MensajeExito = $"Pedido #{pedidoId} rechazado.";
            await CargarCola();
        }
        else
        {
            MensajeError = res.Error;
        }
    }

    private async Task IniciarPreparacionRapido(int pedidoId)
    {
        MensajeError = null;
        var res = await PedidoService.IniciarPreparacionAsync(pedidoId, ScopeActual);
        if (res.EsExitoso)
        {
            MensajeExito = $"Preparación del pedido #{pedidoId} iniciada.";
            await CargarCola();
        }
        else
        {
            MensajeError = res.Error;
        }
    }

    private async Task MarcarListoRapido(int pedidoId)
    {
        MensajeError = null;
        var res = await PedidoService.MarcarListoAsync(pedidoId, ScopeActual);
        if (res.EsExitoso)
        {
            MensajeExito = $"Pedido #{pedidoId} marcado como listo para despacho.";
            await CargarCola();
        }
        else
        {
            MensajeError = res.Error;
        }
    }

    private string ObtenerBadgeEstado(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Confirmado" => "bg-primary",
        "EnPreparacion" => "bg-info text-dark",
        "Listo" => "bg-success",
        "EnCamino" => "bg-primary",
        "Entregado" => "bg-success",
        "NoEntregado" => "bg-dark text-white",
        "Cancelado" => "bg-secondary",
        "Rechazado" => "bg-danger",
        _ => "bg-secondary"
    };
}
