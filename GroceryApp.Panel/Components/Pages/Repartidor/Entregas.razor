@page "/repartidor/entregas"
@page "/repartidor"
@attribute [Authorize(Roles = "Repartidor,Admin")]
@inject EntregaService EntregaService
@inject SucursalService SucursalService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Panel de Entregas — GroceryApp</PageTitle>

<div class="container-fluid py-4">
    <!-- Encabezado y Selector de Pestañas -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Módulo de Entregas y Despacho</h2>
            <p class="text-muted mb-0">Pool de pedidos listos y gestión de entregas asignadas</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-primary" @onclick="CargarDatos" disabled="@Cargando">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
                </svg>
                Actualizar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @MensajeExito
            <button type="button" class="btn-close" @onclick="() => MensajeExito = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @MensajeError
            <button type="button" class="btn-close" @onclick="() => MensajeError = null"></button>
        </div>
    }

    <!-- Selector de Sucursal (Para Admin) -->
    @if (EsAdmin)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="row align-items-center">
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-uppercase text-muted mb-1">Sucursal a Supervisar</label>
                        <select class="form-select border-primary" value="@SucursalIdOperacion" @onchange="OnSucursalChanged">
                            @foreach (var s in ListaSucursales)
                            {
                                <option value="@s.Id">@s.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-8 pt-3 pt-md-0">
                        <span class="badge bg-danger fs-6 px-3 py-2">Vista Administrador (Supervisión y Asignación de Pool)</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Pestañas de Navegación (Solo se muestran si es Admin para supervisión) -->
    @if (EsAdmin)
    {
        <ul class="nav nav-pills nav-fill bg-white p-2 rounded shadow-sm mb-4 border">
            <li class="nav-item">
                <button class="nav-link fw-bold @(PestanaActiva == "MisEntregas" ? "active bg-primary" : "text-dark")"
                        @onclick='() => CambiarPestana("MisEntregas")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-bicycle me-2" viewBox="0 0 16 16">
                        <path d="M4 4.5a.5.5 0 0 1 .5-.5H6a.5.5 0 0 1 0 1v.5h4.14l.386-1.158A.5.5 0 0 1 11 4h1a.5.5 0 0 1 0 1h-.64l-.311.935.807 1.615a.5.5 0 0 1-.894.448l-.824-1.65-2.113 4.226a.5.5 0 0 1-.894-.447L9.932 7H6.5v2.5a.5.5 0 0 1-1 0V5h-1a.5.5 0 0 1-.5-.5"/>
                        <path d="M4 14a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m0 1a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9m8-1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m0 1a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9"/>
                    </svg>
                    Mis Entregas Activas (@MisEntregas.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-bold @(PestanaActiva == "Pool" ? "active bg-primary" : "text-dark")"
                        @onclick='() => CambiarPestana("Pool")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-box-seam me-2" viewBox="0 0 16 16">
                        <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/>
                    </svg>
                    Supervisión de Pool de Sucursal (@PoolDisponibles.Count)
                </button>
            </li>
        </ul>
    }

    <!-- CONTENIDO: PESTAÑA MIS ENTREGAS -->
    @if (PestanaActiva == "MisEntregas")
    {
        @if (Cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando entregas...</span>
                </div>
            </div>
        }
        else if (MisEntregas.Count == 0)
        {
            <div class="card shadow-sm border-0 py-5 text-center">
                <div class="card-body">
                    <div class="text-muted mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-check-circle" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                            <path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">No tienes entregas activas en este momento</h5>
                    <p class="text-muted mb-0">Las entregas te serán asignadas automáticamente cuando los pedidos estén listos en tu sucursal.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var e in MisEntregas)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 border-top border-4 @(e.Estado == "EnCamino" ? "border-primary" : "border-warning")">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">Pedido #@e.PedidoId</h5>
                                    <span class="badge @(e.Estado == "EnCamino" ? "bg-primary" : "bg-warning text-dark") fs-6">
                                        @e.Estado
                                    </span>
                                </div>

                                <div class="mb-3">
                                    <span class="text-muted small d-block">Cliente:</span>
                                    <strong class="fs-6">@e.ClienteNombre</strong>
                                    @if (!string.IsNullOrEmpty(e.ClienteTelefono))
                                    {
                                        <div class="mt-1">
                                            <a href="tel:@e.ClienteTelefono" class="btn btn-sm btn-outline-success py-0 px-2">
                                                📞 @e.ClienteTelefono
                                            </a>
                                        </div>
                                    }
                                </div>

                                <div class="mb-3">
                                    <span class="text-muted small d-block">Dirección de Entrega:</span>
                                    <p class="mb-0 fw-semibold text-dark">
                                        @(string.IsNullOrWhiteSpace(e.DireccionReferencia) ? "Sin referencia" : e.DireccionReferencia)
                                    </p>
                                </div>

                                <div class="bg-light p-3 rounded mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted fw-semibold">Total a Cobrar:</span>
                                        <span class="text-success fs-5 fw-bold">C$ @e.Total.ToString("N2")</span>
                                    </div>
                                    <div class="small text-muted text-end">(Efectivo contra entrega)</div>
                                </div>

                                <div class="d-grid gap-2">
                                    @if (e.Estado == "Asignado")
                                    {
                                        <button class="btn btn-primary fw-semibold btn-lg"
                                                @onclick="() => IniciarRuta(e.Id)"
                                                disabled="@Procesando">
                                            Iniciar Entrega (En Camino)
                                        </button>
                                    }
                                    else if (e.Estado == "EnCamino")
                                    {
                                        <button class="btn btn-success fw-semibold btn-lg"
                                                @onclick="() => CompletarEntrega(e.Id)"
                                                disabled="@Procesando">
                                            ✔ Marcar Entregado (Cobrado)
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => AbrirConfirmacionNoEntregado(e.Id)"
                                                disabled="@Procesando">
                                            ✖ No Entregado (Cliente Ausente)
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- CONTENIDO: PESTAÑA POOL DISPONIBLE (Supervisión solo para Admin) -->
    @if (EsAdmin && PestanaActiva == "Pool")
    {
        @if (Cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando pool...</span>
                </div>
            </div>
        }
        else if (PoolDisponibles.Count == 0)
        {
            <div class="card shadow-sm border-0 py-5 text-center">
                <div class="card-body">
                    <div class="text-muted mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-inbox" viewBox="0 0 16 16">
                            <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm-1.17-.437A1.5 1.5 0 0 1 4.98 3h6.04a1.5 1.5 0 0 1 1.17.563l3.7 4.625a.5.5 0 0 1 .11.312V13a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V8.5a.5.5 0 0 1 .11-.312zm-1.81 5.437.002.001A.5.5 0 0 1 2 9h4a2.5 2.5 0 0 0 5 0h4a.5.5 0 0 1 .002-.002L15 13a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">No hay pedidos pendientes en el Pool</h5>
                    <p class="text-muted mb-0">Todos los pedidos listos han sido asignados o no hay pedidos en espera.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in PoolDisponibles)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 border-top border-4 border-warning">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">Pedido #@p.Id</h5>
                                    <span class="badge bg-warning text-dark fs-6">En espera en Pool</span>
                                </div>

                                <div class="mb-2">
                                    <span class="text-muted small d-block">Cliente:</span>
                                    <strong class="fs-6">@p.ClienteNombre</strong>
                                </div>

                                <div class="mb-3">
                                    <span class="text-muted small d-block">Dirección de Entrega:</span>
                                    <p class="mb-0 fw-semibold text-dark">
                                        @(string.IsNullOrWhiteSpace(p.DireccionReferencia) ? "Sin referencia" : p.DireccionReferencia)
                                    </p>
                                </div>

                                <div class="bg-light p-3 rounded mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted fw-semibold">Total a Cobrar:</span>
                                        <span class="text-success fs-5 fw-bold">C$ @p.Total.ToString("N2")</span>
                                    </div>
                                </div>

                                <div class="alert alert-info py-2 px-3 small mb-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-info-circle me-1" viewBox="0 0 16 16">
                                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                                    </svg>
                                    Supervisión: Se asignará automáticamente en cuanto un repartidor quede disponible.
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Modal Confirmación No Entregado -->
@if (EntregaSeleccionadaParaNoEntrega.HasValue)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">Confirmar No Entrega</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => EntregaSeleccionadaParaNoEntrega = null"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-2">¿Estás seguro de marcar esta entrega como <strong>No Entregada</strong>?</p>
                    <p class="text-muted small mb-0">Esta acción registrará un intento fallido (No-Show) en el perfil del cliente para auditoría interna.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => EntregaSeleccionadaParaNoEntrega = null">Cancelar</button>
                    <button type="button" class="btn btn-danger fw-semibold" @onclick="ConfirmarNoEntregado" disabled="@Procesando">
                        @if (Procesando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Confirmar No Entregado
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string PestanaActiva = "MisEntregas";
    private bool Cargando = true;
    private bool Procesando = false;
    private bool EsAdmin = false;

    private int RepartidorId = 0;
    private int SucursalIdOperacion = 0;
    private List<SucursalDto> ListaSucursales = new();

    private List<EntregaDto> MisEntregas = new();
    private List<PedidoPoolDto> PoolDisponibles = new();

    private int? EntregaSeleccionadaParaNoEntrega;
    private string? MensajeExito;
    private string? MensajeError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        EsAdmin = user.IsInRole("Admin");

        if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var repId))
        {
            RepartidorId = repId;
        }

        if (!EsAdmin)
        {
            if (int.TryParse(user.FindFirst("sucursalId")?.Value, out var sId))
            {
                SucursalIdOperacion = sId;
            }
        }
        else
        {
            ListaSucursales = await SucursalService.ListarAsync();
            if (ListaSucursales.Count > 0)
            {
                SucursalIdOperacion = ListaSucursales.First().Id;
            }
        }

        await CargarDatos();
    }

    private async Task OnSucursalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            SucursalIdOperacion = id;
            await CargarDatos();
        }
    }

    private void CambiarPestana(string pestana)
    {
        PestanaActiva = pestana;
    }

    private async Task CargarDatos()
    {
        Cargando = true;
        MensajeError = null;
        try
        {
            if (RepartidorId > 0)
            {
                MisEntregas = await EntregaService.MisEntregasAsync(RepartidorId);
            }

            if (SucursalIdOperacion > 0)
            {
                PoolDisponibles = await EntregaService.ListarPoolDisponiblesAsync(SucursalIdOperacion);
            }
        }
        catch (Exception ex)
        {
            MensajeError = "Error al cargar entregas: " + ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task IniciarRuta(int entregaId)
    {
        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await EntregaService.MarcarEnCaminoAsync(entregaId, RepartidorId);
            if (res.EsExitoso)
            {
                MensajeExito = "Entrega en camino hacia el cliente.";
                await CargarDatos();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task CompletarEntrega(int entregaId)
    {
        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await EntregaService.MarcarEntregadoAsync(entregaId, RepartidorId);
            if (res.EsExitoso)
            {
                MensajeExito = "¡Entrega completada y cobro registrado exitosamente!";
                await CargarDatos();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }

    private void AbrirConfirmacionNoEntregado(int entregaId)
    {
        EntregaSeleccionadaParaNoEntrega = entregaId;
    }

    private async Task ConfirmarNoEntregado()
    {
        if (!EntregaSeleccionadaParaNoEntrega.HasValue) return;

        Procesando = true;
        MensajeError = null;
        try
        {
            var res = await EntregaService.MarcarNoEntregadoAsync(EntregaSeleccionadaParaNoEntrega.Value, RepartidorId);
            if (res.EsExitoso)
            {
                MensajeExito = "Entrega registrada como no entregada (No-Show).";
                EntregaSeleccionadaParaNoEntrega = null;
                await CargarDatos();
            }
            else
            {
                MensajeError = res.Error;
            }
        }
        finally
        {
            Procesando = false;
        }
    }
}
