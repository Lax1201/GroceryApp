<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-white" href="">GroceryApp</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <!-- Menú para Administrador (visibilidad global) -->
                @if (context.User.IsInRole("Admin"))
                {
                    <div class="px-3 pt-2 pb-1 text-uppercase text-white-50 fw-semibold" style="font-size: 0.75rem;">
                        Administración
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/catalogo">
                            <span class="bi bi-box-seam" aria-hidden="true"></span> Catálogo
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/sucursales">
                            <span class="bi bi-shop" aria-hidden="true"></span> Sucursales
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="sucursal/pedidos">
                            <span class="bi bi-clipboard-check" aria-hidden="true"></span> Cola de Pedidos
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="repartidor/entregas">
                            <span class="bi bi-bicycle" aria-hidden="true"></span> Entregas / Despacho
                        </NavLink>
                    </div>
                }

                <!-- Menú para Empleado de Sucursal -->
                @if (context.User.IsInRole("EmpleadoSucursal"))
                {
                    <div class="px-3 pt-2 pb-1 text-uppercase text-white-50 fw-semibold" style="font-size: 0.75rem;">
                        Operación Sucursal
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="sucursal/pedidos">
                            <span class="bi bi-clipboard-check" aria-hidden="true"></span> Cola de Pedidos
                        </NavLink>
                    </div>
                }

                <!-- Menú para Repartidor -->
                @if (context.User.IsInRole("Repartidor"))
                {
                    <div class="px-3 pt-2 pb-1 text-uppercase text-white-50 fw-semibold" style="font-size: 0.75rem;">
                        Entregas
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="repartidor/entregas">
                            <span class="bi bi-bicycle" aria-hidden="true"></span> Mis Entregas / Pool
                        </NavLink>
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Iniciar Sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
